{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edge",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "canvas_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "$ref": "#/$defs/EdgeType"
    },
    "anchor": {
      "description": "Present exactly when `type = branch`, as is `doubt_type`.",
      "anyOf": [
        {
          "$ref": "#/$defs/Anchor"
        },
        {
          "type": "null"
        }
      ]
    },
    "doubt_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/DoubtType"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "merged_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collapsed": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "canvas_id",
    "source_id",
    "target_id",
    "type",
    "collapsed",
    "created_at"
  ],
  "$defs": {
    "EdgeType": {
      "type": "string",
      "enum": [
        "reply",
        "branch"
      ]
    },
    "Anchor": {
      "description": "Where a branch hangs off its parent. `start`/`end` are UTF-16 code-unit offsets\ninto the parent's raw markdown; for `code` they cover the whole block.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "start": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "start",
            "end",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "code"
            },
            "start": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "start_line": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "end_line": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "start",
            "end",
            "start_line",
            "end_line",
            "text"
          ]
        }
      ]
    },
    "DoubtType": {
      "type": "string",
      "enum": [
        "simpler",
        "example",
        "why",
        "deeper",
        "wrong",
        "free"
      ]
    }
  }
}
